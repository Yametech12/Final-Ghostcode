# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values

# =================================================================
# APP CONFIGURATION
# =================================================================
APP_URL=https://your-app-domain.vercel.app

# =================================================================
# SUPABASE CONFIGURATION
# =================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# BACKEND ONLY – DO NOT PREFIX WITH VITE_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =================================================================
# AI API CONFIGURATION
# =================================================================
# Regolo AI API Key - Get from: https://regolo.ai/
# BACKEND ONLY – DO NOT PREFIX WITH VITE_ (would leak the key into the client bundle)
REGOLO_API_KEY=your_regolo_api_key_here

# =================================================================
# ERROR MONITORING (SENTRY)
# =================================================================
# Get DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# Optional - if empty, Sentry is disabled.
VITE_SENTRY_DSN=

# =================================================================
# CORS / SERVER
# =================================================================
# Comma-separated list of additional origins to allow. The server already
# allows localhost (5173/5174/3000), epimetheusproject.vercel.app, and
# epimetheus.ai. Anything you set here is added to that allow-list.
ALLOWED_ORIGINS=

PORT=3000
NODE_ENV=development

# =================================================================
# SETUP NOTES
# =================================================================
# 1. SUPABASE: create the project at https://supabase.com, then copy the
#    URL + anon key + service role key from Settings > API. Email delivery
#    (verification, password reset) is handled by Supabase out of the box.
# 2. REGOLO AI: sign up at https://regolo.ai, create an API key, fund the
#    account. The key MUST stay server-only.
# 3. SQL: run, in order, every file in supabase/migrations/ via the Supabase
#    CLI (`supabase db reset`) or by hand in the SQL editor.
#
# =================================================================
# SECURITY REMINDERS
# =================================================================
# 🔒 NEVER commit .env files to version control
# 🔒 Use different keys for staging vs production
# 🔒 Rotate SUPABASE_SERVICE_ROLE_KEY and REGOLO_API_KEY every 30-90 days
# 🔒 Never prefix server secrets with VITE_ (they would be inlined into the
#    client bundle on `vite build`)
