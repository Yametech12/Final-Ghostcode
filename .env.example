# .env.example — Template for environment variables
# Copy this file to .env and fill in your actual values.

# =================================================================
# APP CONFIGURATION
# =================================================================
APP_URL=https://your-app-domain.vercel.app

# =================================================================
# SUPABASE CONFIGURATION
# =================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# BACKEND ONLY — DO NOT PREFIX WITH VITE_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =================================================================
# AI API CONFIGURATION
# =================================================================
# Regolo AI API Key — server-only. Never prefix with VITE_ (would leak
# the key into the bundled client JS).
REGOLO_API_KEY=your_regolo_api_key_here
REGOLO_API_ENDPOINT=https://api.regolo.ai/v1

# Optional fallback provider. Server-only; no VITE_ prefix.
OPENROUTER_API_KEY=

# =================================================================
# ERROR MONITORING (SENTRY)
# =================================================================
# Two separate DSNs because the client and server can target different
# Sentry projects (and the client one is bundled into the JS, so it
# leaks the project — that's expected for the React DSN, not OK for the
# server one).
#
# • VITE_SENTRY_DSN — public, bundled into client. React errors only.
# • SENTRY_DSN      — server-only. Express + Vercel function errors.
#                     Reuse the same DSN if you want both streams in one
#                     project.
VITE_SENTRY_DSN=
SENTRY_DSN=

# =================================================================
# CORS / SERVER
# =================================================================
# Comma-separated list of additional origins to allow. The server already
# allows localhost (5173/5174/3000), epimetheusproject.vercel.app, and
# epimetheus.ai. Anything you set here is APPENDED to that allow-list.
ALLOWED_ORIGINS=

PORT=3000
NODE_ENV=development

# Server-side log level. info | warn | error | debug.
# Defaults: info in production, debug otherwise. Override here if needed.
LOG_LEVEL=

# =================================================================
# OPTIONAL — FEATURES NOT YET WIRED IN PROD
# =================================================================
# reCAPTCHA on auth pages (the var is referenced by code that is gated
# by the var being non-empty; leaving blank is the off switch).
VITE_RECAPTCHA_SITE_KEY=

# Outbound mail. Reserved for verification email flow.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Analytics measurement id, e.g. "G-XXXXXXXXXX".
VITE_GA_TRACKING_ID=

# Override the API base URL when the frontend is hosted separately from
# the API. Leave blank to default to "/api".
VITE_API_BASE_URL=

# =================================================================
# STRIPE — checkout integration (work in progress, not live yet)
# =================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# These are Stripe Price IDs (NOT dollar amounts). They look like
# "price_1Q2..." or "price_abc123XYZ". Find them in the Stripe dashboard
# under Products > <your product> > Pricing. Each plan has separate
# monthly and annual prices configured in Stripe — paste the IDs here.
STRIPE_PRICE_STRATEGIST_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STRATEGIST_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ORACLE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ORACLE_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# =================================================================
# GOOGLE CLOUD STORAGE — currently unused; reserved for future migration
# =================================================================
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_BUCKET_NAME=
VITE_GCP_BUCKET_NAME=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=

# =================================================================
# SETUP NOTES
# =================================================================
# 1. SUPABASE: create the project at https://supabase.com, then copy the
#    URL + anon key + service role key from Settings > API.
# 2. REGOLO AI: sign up at https://regolo.ai, create an API key, fund the
#    account. The key MUST stay server-only.
# 3. SQL: run, in order, every file in supabase/migrations/ via the Supabase
#    CLI (`supabase db reset`) or by hand in the SQL editor.
#
# =================================================================
# SECURITY REMINDERS
# =================================================================
# 🔒 NEVER commit .env files to version control.
# 🔒 Use different keys for staging vs production.
# 🔒 Rotate SUPABASE_SERVICE_ROLE_KEY and REGOLO_API_KEY every 30-90 days.
# 🔒 Never prefix server secrets with VITE_ (they would be inlined into the
#    client bundle on `vite build`).
